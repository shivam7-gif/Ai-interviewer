{
  "name": "interviewos-ai-workspace",
  "version": "1.0.0",
  "description": "InterviewOS AI – Scalable full-stack AI interview platform",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend/app run dev",
    "dev:ai": "npm --prefix aiengine run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend/app run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend/app run type-check",
    "lint:ai": "npm --prefix aiengine run dev --noEmit",
    "lint:all": "npm run lint:backend && npm run lint:frontend",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
  "keywords": [
    "ai",
    "interview",
    "webrtc",
    "livekit",
    "groq",
    "react19",
    "typescript",
    "docker"
  ],
  "author": "Shivam",
  "license": "MIT"
}
