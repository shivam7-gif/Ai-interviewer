# InterviewOS AI – Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Allowed frontend origin for CORS (e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interviewer"

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── GitHub API (optional) ─────────────────────────────────────────────────────
# Add a personal access token to increase rate limits (60 → 5000 req/hr)
# GITHUB_TOKEN=ghp_your_token_here
