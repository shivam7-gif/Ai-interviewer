generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String?
  role       UserRole    @default(Candidate)
  createdAt  DateTime    @default(now()) @map("created_at")
  interviews Interview[]

  @@map("users")
}

model Playlist {
  id          String     @id @default(uuid())
  title       String
  description String?
  difficulty  Difficulty
  createdAt   DateTime   @default(now()) @map("created_at")
  problems    Question[]

  @@map("playlists")
}

model Question {
  id           String      @id @default(uuid())
  playlistId   String?     @map("playlist_id")
  slug         String      @unique
  title        String
  description  String
  inputFormat  String?     @map("input_format")
  outputFormat String?     @map("output_format")
  constraints  String?
  difficulty   Difficulty
  tags         String[]    @default([])
  companies    String[]    @default([])
  orderIndex   Int?        @map("order_index")
  createdAt    DateTime    @default(now()) @map("created_at")

  playlist     Playlist?   @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  examples     Example[]
  testCases    TestCase[]
  solutions    Solution[]
  interviews   Interview[]

  @@map("questions")
}

model Example {
  id          String   @id @default(uuid())
  questionId  String   @map("question_id")
  input       String
  output      String
  explanation String?
  orderIndex  Int      @default(0) @map("order_index")

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("examples")
}

model TestCase {
  id             String   @id @default(uuid())
  questionId     String   @map("question_id")
  input          String
  expectedOutput String   @map("expected_output")
  isSample       Boolean  @default(false) @map("is_sample")
  isHidden       Boolean  @default(true) @map("is_hidden")

  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Solution {
  id              String   @id @default(uuid())
  questionId      String   @map("question_id")
  approachText    String?  @map("approach_text")
  editorialCode   String?  @map("editorial_code")
  language        String?
  timeComplexity  String?  @map("time_complexity")
  spaceComplexity String?  @map("space_complexity")

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("solutions")
}

model Interview {
  id          String          @id @default(uuid())
  candidateId String          @map("candidate_id")
  questionId  String          @map("question_id")
  status      InterviewStatus @default(Pre)
  score       Int             @default(0)
  metaData    Json?           @map("meta_data")
  startedAt   DateTime?       @map("started_at")
  endedAt     DateTime?       @map("ended_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  candidate   User            @relation(fields: [candidateId], references: [id])
  question    Question        @relation(fields: [questionId], references: [id])
  messages    Message[]
  snapshots   CodeSnapshot[]
  submissions Submission[]

  @@map("interviews")
}

model Message {
  id          String      @id @default(uuid())
  interviewId String      @map("interview_id")
  message     String
  type        MessageType
  audioUrl    String?     @map("audio_url")
  createdAt   DateTime    @default(now()) @map("created_at")

  interview   Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
  @@map("messages")
}

model CodeSnapshot {
  id          String          @id @default(uuid())
  interviewId String          @map("interview_id")
  code        String
  language    String
  trigger     SnapshotTrigger
  createdAt   DateTime        @default(now()) @map("created_at")

  interview   Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
  @@map("code_snapshots")
}

model Submission {
  id          String             @id @default(uuid())
  interviewId String             @map("interview_id")
  code        String
  language    String
  verdict     SubmissionVerdict  @default(Pending)
  runtimeMs   Int?               @map("runtime_ms")
  memoryKb    Int?               @map("memory_kb")
  createdAt   DateTime           @default(now()) @map("created_at")

  interview   Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  results     SubmissionResult[]

  @@map("submissions")
}

model SubmissionResult {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  testCaseId   String     @map("test_case_id")
  passed       Boolean
  actualOutput String?    @map("actual_output")
  runtimeMs    Int?       @map("runtime_ms")

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_results")
}

enum UserRole {
  Candidate
  Interviewer
  Admin
}

enum MessageType {
  User
  Assistance
  System
}

enum SnapshotTrigger {
  Interval
  SignificantDiff
  ManualSubmit
}

enum SubmissionVerdict {
  Pending
  Accepted
  WrongAnswer
  RuntimeError
  TimeLimitExceeded
  CompileError
}

enum InterviewStatus {
  Pre
  InProgress
  Coding
  WrapUp
  Done
  Abandoned
}

enum Difficulty {
  Beginner
  Intermediate
  Advanced
}

model CodeforcesProfile {
  id                  String   @id @default(uuid())
  handle              String   @unique
  rating              Int?
  maxRating           Int?     @map("max_rating")
  rank                String?
  maxRank             String?  @map("max_rank")
  solvedRecent        Int      @default(0) @map("solved_recent")
  submissionsAnalysed Int      @default(0) @map("submissions_analysed")
  strongTags          String[] @default([]) @map("strong_tags")
  weakTags            String[] @default([]) @map("weak_tags")
  summary             String?
  profileData         Json?    @map("profile_data")
  fetchedAt           DateTime @default(now()) @map("fetched_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("codeforces_profiles")
}