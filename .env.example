# ==============================================================================
# InterviewOS AI – Global Environment Configuration
# ==============================================================================

# ── General Server Settings ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://your-domain.com

# ── Database (PostgreSQL / Neon) ──────────────────────────────────────────────
# Local Docker Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interviewos"
# Or Neon Serverless Postgres:
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Docker PostgreSQL Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interviewos
POSTGRES_PORT=5432

# ── AI Engine / LLM Provider ──────────────────────────────────────────────────
# Groq Cloud API Key for ultra-fast LLaMA 3.3 70B inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── LiveKit Cloud (Real-time Audio / WebRTC) ───────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── GitHub API (Optional: avoid rate limits) ──────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token_here

# ── Authentication & Security ─────────────────────────────────────────────────
JWT_SECRET=generate-a-secure-random-64-character-secret-key-for-production
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_BACKEND_URL=https://api.your-domain.com
